digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.6, ranksep=1.1, bgcolor="white"];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];

  subscribers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1f6f78" colspan="2"><font color="white"><b>subscribers</b></font></td></tr>
    <tr><td align="left"><b>subscriber_no</b></td><td align="left">varchar(20) PK</td></tr>
    <tr><td align="left">full_name</td><td align="left">varchar(100)</td></tr>
    <tr><td align="left">plan_name</td><td align="left">varchar(50)</td></tr>
    <tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];

  app_users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1f6f78" colspan="2"><font color="white"><b>app_users</b></font></td></tr>
    <tr><td align="left"><b>id</b></td><td align="left">serial PK</td></tr>
    <tr><td align="left">username</td><td align="left">varchar(50) UNIQUE</td></tr>
    <tr><td align="left">password_hash</td><td align="left">varchar(200) bcrypt</td></tr>
    <tr><td align="left">role</td><td align="left">SUBSCRIBER | ADMIN</td></tr>
    <tr><td align="left">subscriber_no</td><td align="left">FK, nullable</td></tr></table>>];

  usage_records [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1f6f78" colspan="2"><font color="white"><b>usage_records</b></font></td></tr>
    <tr><td align="left"><b>id</b></td><td align="left">serial PK</td></tr>
    <tr><td align="left">subscriber_no</td><td align="left">FK</td></tr>
    <tr><td align="left">year, month</td><td align="left">int, int (1-12)</td></tr>
    <tr><td align="left">usage_type</td><td align="left">PHONE | INTERNET</td></tr>
    <tr><td align="left">quantity</td><td align="left">int &gt; 0 (min or MB)</td></tr>
    <tr><td align="left">recorded_at</td><td align="left">timestamptz</td></tr></table>>];

  bills [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1f6f78" colspan="2"><font color="white"><b>bills</b></font></td></tr>
    <tr><td align="left"><b>id</b></td><td align="left">serial PK</td></tr>
    <tr><td align="left">subscriber_no</td><td align="left">FK</td></tr>
    <tr><td align="left">year, month</td><td align="left">UNIQUE(subscriber_no, year, month)</td></tr>
    <tr><td align="left">phone_minutes, internet_mb</td><td align="left">int</td></tr>
    <tr><td align="left">phone_charge, internet_charge</td><td align="left">numeric(10,2)</td></tr>
    <tr><td align="left">total, paid_amount</td><td align="left">numeric(10,2)</td></tr>
    <tr><td align="left">currency</td><td align="left">char(3) USD</td></tr>
    <tr><td align="left">status</td><td align="left">UNPAID | PARTIALLY_PAID | PAID</td></tr>
    <tr><td align="left">calculated_at</td><td align="left">timestamptz</td></tr></table>>];

  payments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1f6f78" colspan="2"><font color="white"><b>payments</b></font></td></tr>
    <tr><td align="left"><b>id</b></td><td align="left">serial PK</td></tr>
    <tr><td align="left">transaction_id</td><td align="left">varchar(64) UNIQUE</td></tr>
    <tr><td align="left">bill_id</td><td align="left">FK</td></tr>
    <tr><td align="left">amount</td><td align="left">numeric(10,2) &gt; 0</td></tr>
    <tr><td align="left">paid_by</td><td align="left">varchar(50)</td></tr>
    <tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];

  subscribers -> app_users     [label="0..1 login", arrowhead=odot];
  subscribers -> usage_records [label="1 : N"];
  subscribers -> bills         [label="1 : N (one per month)"];
  bills -> payments            [label="1 : N"];
}
