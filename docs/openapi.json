  },
  "components": {
    "schemas": {
      "AddUsageRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "examples": [
              2025
            ]
          },
          "usageType": {
            "$ref": "#/components/schemas/UsageType",
            "examples": [
              "INTERNET"
            ]
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "usageType"
        ],
        "title": "AddUsageRequest"
      },
      "AddUsageResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "SUCCESS"
          },
          "subscriberNo": {
            "type": "string",
            "title": "Subscriberno"
          },
          "month": {
            "type": "integer",
            "title": "Month"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "usageType": {
            "$ref": "#/components/schemas/UsageType"
          },
          "addedQuantity": {
            "type": "integer",
            "title": "Addedquantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "periodTotal": {
            "type": "integer",
            "title": "Periodtotal"
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "usageType",
          "addedQuantity",
          "unit",
          "periodTotal"
        ],
        "title": "AddUsageResponse"
      },
      "BillDetailed": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "title": "Subscriberno"
          },
          "month": {
            "type": "integer",
            "title": "Month"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "billTotal": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Billtotal"
          },
          "paidAmount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Paidamount"
          },
          "remainingBalance": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Remainingbalance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "phoneMinutes": {
            "type": "integer",
            "title": "Phoneminutes"
          },
          "internetMb": {
            "type": "integer",
            "title": "Internetmb"
          },
          "internetGb": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Internetgb"
          },
          "charges": {
            "items": {
              "$ref": "#/components/schemas/ChargeLine"
            },
            "type": "array",
            "title": "Charges"
          },
          "usageRecords": {
            "items": {
              "$ref": "#/components/schemas/UsageLine"
            },
            "type": "array",
            "title": "Usagerecords"
          },
          "paging": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "billTotal",
          "paidAmount",
          "remainingBalance",
          "currency",
          "status",
          "phoneMinutes",
          "internetMb",
          "internetGb",
          "charges",
          "usageRecords",
          "paging"
        ],
        "title": "BillDetailed"
      },
      "BillSummary": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "title": "Subscriberno"
          },
          "month": {
            "type": "integer",
            "title": "Month"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "billTotal": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Billtotal"
          },
          "paidAmount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Paidamount"
          },
          "remainingBalance": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Remainingbalance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "billTotal",
          "paidAmount",
          "remainingBalance",
          "currency",
          "status"
        ],
        "title": "BillSummary"
      },
      "CalculateBillRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "examples": [
              2025
            ]
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year"
        ],
        "title": "CalculateBillRequest"
      },
      "ChargeLine": {
        "properties": {
          "item": {
            "type": "string",
            "title": "Item"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "item",
          "quantity",
          "unit",
          "amount",
          "note"
        ],
        "title": "ChargeLine"
      },
      "ErrorResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ERROR"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PageInfo": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "totalItems": {
            "type": "integer",
            "title": "Totalitems"
          },
          "totalPages": {
            "type": "integer",
            "title": "Totalpages"
          }
        },
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "title": "PageInfo"
      },
      "PayBillRequest": {
        "properties": {
          "subscriberNo": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Subscriberno",
            "examples": [
              "5551001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "examples": [
              2025
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount",
            "examples": [
              25.0
            ]
          },
          "transactionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 6,
            "title": "Transactionid",
            "examples": [
              "TX-2025-10-0001"
            ]
          }
        },
        "type": "object",
        "required": [
          "subscriberNo",
          "month",
          "year",
          "amount",
          "transactionId"
        ],
        "title": "PayBillRequest"
      },
      "PayBillResponse": {
        "properties": {
          "paymentStatus": {
            "type": "string",
            "title": "Paymentstatus"
          },
          "transactionId": {
            "type": "string",
            "title": "Transactionid"
          },
          "paidAmount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Paidamount"
          },
