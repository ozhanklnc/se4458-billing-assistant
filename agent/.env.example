# Copy to agent/.env and fill in.

# API gateway (all REST calls go here) and MCP server
# Azure deployment
GATEWAY_URL=https://gateway.yellowsmoke-193d061f.germanywestcentral.azurecontainerapps.io
MCP_URL=https://mcp-server.yellowsmoke-193d061f.germanywestcentral.azurecontainerapps.io/mcp
# Local docker compose
# GATEWAY_URL=http://localhost:8000
# MCP_URL=http://localhost:8001/mcp

# Any OpenAI-compatible chat completions endpoint with tool calling.
# Default: Google Gemini (free tier key from https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# low keeps Gemini 3.x thinking short (much faster). Leave empty for models without reasoning.
LLM_REASONING_EFFORT=low

# Alternative: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_REASONING_EFFORT=

# Optional, to skip the login prompt
# AGENT_USERNAME=deniz
# AGENT_PASSWORD=Deniz!2026
